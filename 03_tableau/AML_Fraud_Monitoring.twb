            <column datatype='string' name='[txn_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[alert_reasons]' role='dimension' type='nominal' />
            <column datatype='string' name='[outcome]' role='dimension' type='nominal' />
            <column datatype='real' name='[amount]' role='measure' type='quantitative' default-format='*"$"#,##0' />
            <column-instance column='[queue_rank]' derivation='None' name='[none:queue_rank:ok]' pivot='key' type='ordinal' />
            <column-instance column='[txn_type]' derivation='None' name='[none:txn_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[alert_reasons]' derivation='None' name='[none:alert_reasons:nk]' pivot='key' type='nominal' />
            <column-instance column='[outcome]' derivation='None' name='[none:outcome:nk]' pivot='key' type='nominal' />
            <column-instance column='[amount]' derivation='Sum' name='[sum:amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
