            <format attr='tick-color' value='#00000000' />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-size' value='10' /><format attr='color' value='#14213D' /><format attr='width' field='[federated.martalertqueue].[none:queue_rank:ok]' value='34' /><format attr='width' field='[federated.martalertqueue].[none:txn_type:nk]' value='86' /><format attr='width' field='[federated.martalertqueue].[none:alert_reasons:nk]' value='290' /><format attr='width' field='[federated.martalertqueue].[none:outcome:nk]' value='112' />
          </style-rule>
