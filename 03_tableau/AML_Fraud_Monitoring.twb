        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><color column='[federated.martalertqueue].[none:outcome:nk]' /><text column='[federated.martalertqueue].[sum:amount:qk]' /></encodings>
            
