    <worksheet name="Rule Performance">
      <layout-options>
        <title><formatted-text><run fontcolor='#14213D' fontname='Tableau Semibold' fontsize='14'>Share of fraud caught, by rule</run><run fontcolor='#6B7280' fontname='Tableau Book' fontsize='10'>&#10;grey = old flag, violet = single rule, red = combined score</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption='mart_rule_performance' name='federated.martruleperformance' /></datasources>
          <datasource-dependencies datasource='federated.martruleperformance'>
            <column datatype='string' name='[rule_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[recall_rate]' role='measure' type='quantitative' default-format="p0%" />
            <column datatype='string' name='[rule_group]' role='dimension' type='nominal' />
            <column-instance column='[rule_name]' derivation='None' name='[none:rule_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[recall_rate]' derivation='Sum' name='[sum:recall_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[rule_group]' derivation='None' name='[none:rule_group:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <sort class='computed' column='[federated.martruleperformance].[none:rule_name:nk]' direction='DESC' using='[federated.martruleperformance].[sum:recall_rate:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='font-size' value='10' /><format attr='color' value='#6B7280' />
            <format attr='tick-color' value='#00000000' /><format attr='display' class='0' field='[federated.martruleperformance].[sum:recall_rate:qk]' scope='cols' value='false' />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-size' value='10' /><format attr='color' value='#14213D' />
          </style-rule>
          <style-rule element='label'><format attr='font-size' value='10' /><format attr='color' value='#14213D' /></style-rule>
          <style-rule element='cell'><format attr='text-align' value='left' /></style-rule>
          <style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='table'><format attr='show-null-value-warning' value='false' /></style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.martruleperformance].[none:rule_group:nk]' /></encodings>
            
            <style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style>
          </pane>
        </panes>
        <rows>[federated.martruleperformance].[none:rule_name:nk]</rows>
        <cols>[federated.martruleperformance].[sum:recall_rate:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Fraud by Hour">
      <layout-options>
        <title><formatted-text><run fontcolor='#14213D' fontname='Tableau Semibold' fontsize='14'>Fraud cases by hour of day</run><run fontcolor='#6B7280' fontname='Tableau Book' fontsize='10'>&#10;fraud keeps going overnight while normal traffic drops</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption='mart_hourly' name='federated.marthourly' /></datasources>
          <datasource-dependencies datasource='federated.marthourly'>
            <column datatype='integer' name='[fraud_count]' role='measure' type='quantitative' default-format="n#,##0" />
            <column datatype='integer' name='[hour_of_day]' role='dimension' type='ordinal' />
            <column-instance column='[fraud_count]' derivation='Sum' name='[sum:fraud_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[hour_of_day]' derivation='None' name='[none:hour_of_day:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='font-size' value='10' /><format attr='color' value='#6B7280' />
            <format attr='tick-color' value='#00000000' />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-size' value='10' /><format attr='color' value='#14213D' />
          </style-rule>
          <style-rule element='label'><format attr='font-size' value='10' /><format attr='color' value='#14213D' /></style-rule>
          <style-rule element='cell'><format attr='text-align' value='left' /></style-rule>
          <style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='table'><format attr='show-null-value-warning' value='false' /></style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            
            
            <style><style-rule element='mark'><format attr='mark-color' value='#5B4BDB' /><format attr='mark-labels-show' value='false' /></style-rule></style>
          </pane>
        </panes>
        <rows>[federated.marthourly].[sum:fraud_count:qk]</rows>
        <cols>[federated.marthourly].[none:hour_of_day:ok]</cols>
      </table>
    </worksheet>
    <worksheet name="Fraud by Type">
      <layout-options>
        <title><formatted-text><run fontcolor='#14213D' fontname='Tableau Semibold' fontsize='14'>Fraud value by type</run><run fontcolor='#6B7280' fontname='Tableau Book' fontsize='10'>&#10;only TRANSFER and CASH OUT have fraud</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption='mart_hourly' name='federated.marthourly' /></datasources>
          <datasource-dependencies datasource='federated.marthourly'>
            <column datatype='string' name='[txn_type]' role='dimension' type='nominal' />
            <column datatype='real' name='[fraud_amount]' role='measure' type='quantitative' default-format='*"$"#,##0,,"M"' />
            <column-instance column='[txn_type]' derivation='None' name='[none:txn_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[fraud_amount]' derivation='Sum' name='[sum:fraud_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <sort class='computed' column='[federated.marthourly].[none:txn_type:nk]' direction='DESC' using='[federated.marthourly].[sum:fraud_amount:qk]' />
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='display-field-labels' scope='rows' value='false' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='font-size' value='10' /><format attr='color' value='#6B7280' />
            <format attr='tick-color' value='#00000000' /><format attr='display' class='0' field='[federated.marthourly].[sum:fraud_amount:qk]' scope='cols' value='false' />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-size' value='10' /><format attr='color' value='#14213D' />
          </style-rule>
          <style-rule element='label'><format attr='font-size' value='10' /><format attr='color' value='#14213D' /></style-rule>
          <style-rule element='cell'><format attr='text-align' value='left' /></style-rule>
          <style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='table'><format attr='show-null-value-warning' value='false' /></style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            
            
            <style><style-rule element='mark'><format attr='mark-color' value='#D62839' /><format attr='mark-labels-show' value='true' /></style-rule></style>
          </pane>
        </panes>
        <rows>[federated.marthourly].[none:txn_type:nk]</rows>
        <cols>[federated.marthourly].[sum:fraud_amount:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Data Quality">
      <layout-options>
        <title><formatted-text><run fontcolor='#14213D' fontname='Tableau Semibold' fontsize='14'>What cleaning did</run><run fontcolor='#6B7280' fontname='Tableau Book' fontsize='10'>&#10;every removed row is logged in dq_removed_rows</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption='mart_data_quality' name='federated.martdataquality' /></datasources>
          <datasource-dependencies datasource='federated.martdataquality'>
            <column datatype='string' name='[dq_issue]' role='dimension' type='nominal' />
            <column datatype='string' name='[action]' role='dimension' type='nominal' />
            <column datatype='integer' name='[row_count]' role='measure' type='quantitative' default-format="n#,##0" />
            <column-instance column='[dq_issue]' derivation='None' name='[none:dq_issue:nk]' pivot='key' type='nominal' />
            <column-instance column='[action]' derivation='None' name='[none:action:nk]' pivot='key' type='nominal' />
            <column-instance column='[row_count]' derivation='Sum' name='[sum:row_count:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='worksheet'>
            <format attr='font-family' value='Tableau Book' />
            <format attr='display-field-labels' scope='rows' value='true' />
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
          <style-rule element='axis'>
            <format attr='font-size' value='10' /><format attr='color' value='#6B7280' />
            <format attr='tick-color' value='#00000000' />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-size' value='10' /><format attr='color' value='#14213D' /><format attr='width' field='[federated.martdataquality].[none:dq_issue:nk]' value='160' /><format attr='width' field='[federated.martdataquality].[none:action:nk]' value='116' />
          </style-rule>
          <style-rule element='label'><format attr='font-size' value='10' /><format attr='color' value='#14213D' /></style-rule>
          <style-rule element='cell'><format attr='text-align' value='left' /><format attr='width' value='96' /></style-rule>
          <style-rule element='gridline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='zeroline'><format attr='line-visibility' value='off' /></style-rule>
          <style-rule element='table'><format attr='show-null-value-warning' value='false' /></style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.martdataquality].[sum:row_count:qk]' /></encodings>
            
            <style><style-rule element='mark'><format attr='mark-labels-show' value='false' /></style-rule></style>
          </pane>
        </panes>
        <rows>[federated.martdataquality].[none:dq_issue:nk] / [federated.martdataquality].[none:action:nk]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Alert Queue">
      <layout-options>
        <title><formatted-text><run fontcolor='#14213D' fontname='Tableau Semibold' fontsize='14'>Top 100 alerts by risk score</run><run fontcolor='#6B7280' fontname='Tableau Book' fontsize='10'>&#10;what an investigator would work through first</run></formatted-text></title>
      </layout-options>
      <table>
        <view>
          <datasources><datasource caption='mart_alert_queue' name='federated.martalertqueue' /></datasources>
          <datasource-dependencies datasource='federated.martalertqueue'>
