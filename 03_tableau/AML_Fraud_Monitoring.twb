          </pane>
        </panes>
        <rows>[federated.martalertqueue].[none:queue_rank:ok] / [federated.martalertqueue].[none:txn_type:nk] / [federated.martalertqueue].[none:alert_reasons:nk] / [federated.martalertqueue].[none:outcome:nk]</rows>
        <cols></cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='AML Monitoring Dashboard'>
      <style>
        <style-rule element='table'><format attr='background-color' value='#F3F4F8' /></style-rule>
      </style>
      <size maxheight='1000' maxwidth='1600' minheight='1000' minwidth='1600' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone x='0' y='0' w='100000' h='8000' id='2' type-v2='text'><formatted-text><run fontcolor='#FFFFFF' fontname='Tableau Semibold' fontsize='22'>AML Transaction Monitoring&#10;</run><run fontcolor='#C9CEDA' fontname='Tableau Book' fontsize='11'>PaySim mobile-money data, 6.3M transactions. Can a few explainable SQL rules beat a flag that misses almost all fraud?</run></formatted-text><zone-style><format attr='background-color' value='#14213D' /><format attr='border-style' value='none' /><format attr='padding' value='10' /></zone-style></zone>
